# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token

# Telegram ID пользователей, которым разрешён доступ (через запятую).
# Узнать свой ID: напишите боту /start — он покажет ваш ID.
ALLOWED_USERS=111111111

# Ключ шифрования для AWS-секретов (Fernet). Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если оставить пустым — ключ будет создан автоматически в data/fernet.key
ENCRYPTION_KEY=

# Путь к базе данных
DB_PATH=data/bot.db
